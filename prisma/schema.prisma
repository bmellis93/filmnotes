generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ShareLink {
  id                  String    @id @default(cuid())
  orgId               String
  token               String    @unique
  videoId             String?
  galleryId           String?
  title               String?
  allowedVideoIdsJson String?
  stacksJson          String?
  view                ShareView @default(REVIEW_DOWNLOAD)
  allowComments       Boolean   @default(true)
  allowDownload       Boolean   @default(false)
  createdAt           DateTime  @default(now())
  expiresAt           DateTime?
  revokedAt           DateTime?
  contactId           String?
  contactName         String?
  conversationId      String?
  nudgedAt            DateTime?
  video               Video?    @relation(fields: [videoId], references: [id])

  @@index([token])
  @@index([orgId])
  @@index([galleryId])
  @@index([videoId])
}

model Comment {
  id         String        @id @default(cuid())
  orgId      String
  token      String
  videoId    String
  timecodeMs Int
  body       String
  author     String?
  role       CommentRole   @default(CLIENT)
  createdAt  DateTime      @default(now())
  parentId   String?
  status     CommentStatus @default(OPEN)
  isApprovalNote Boolean   @default(false)
  annotationJson String?
  parent     Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]     @relation("CommentReplies")

  @@index([token, createdAt])
  @@index([videoId])
  @@index([videoId, timecodeMs])
  @@index([parentId, createdAt])
  @@index([videoId, status])
  @@index([orgId])
}

model VideoView {
  id            String   @id @default(cuid())
  orgId         String
  token         String
  videoId       String
  firstViewedAt DateTime @default(now())
  lastViewedAt  DateTime @default(now())
  viewCount     Int      @default(1)

  @@unique([token, videoId])
  @@index([videoId])
  @@index([orgId])
}

model Video {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      VideoStatus @default(UPLOADED)

  sourceUrl     String
  thumbnailUrl  String?
  thumbnailKey      String?
  thumbnailIsCustom Boolean @default(false)
  muxAssetId    String?
  muxPlaybackId String? // signed playback id -- used for actual video streaming (token required)
  muxPublicPlaybackId String? // public playback id -- used only for thumbnails/gifs (no token)
  playbackUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  archivedAt    DateTime?
  deletedAt     DateTime?

  approvalStatus    ApprovalStatus @default(PENDING)
  approvalUpdatedAt DateTime?
  approvalNote      String?

  changeNote String?

  // High-water mark for batched client-comment notifications (see
  // lib/notify/flushCommentNotifications.ts) -- null means nothing notified yet.
  commentsNotifiedThroughAt DateTime?

  galleryVideos GalleryVideo[]

  shareLinks ShareLink[]

  originalKey  String?
  originalName String?
  originalMime String?
  originalSize BigInt?

  // Set once this video's originalSize has been counted into the org's
  // monthly ingestedBytesThisPeriod meter (see Org model) -- guards against
  // double-counting if Mux redelivers the video.asset.ready webhook.
  ingestCountedAt DateTime?

  failureReason String?

  @@index([createdAt])
  @@index([status])
  @@index([orgId])
  @@index([originalKey])
  @@index([archivedAt])
  @@index([approvalStatus])
  @@index([deletedAt])
}

model Gallery {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title      String?
  stacksJson String?
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  archivedAt DateTime?
  deletedAt  DateTime?

  videos GalleryVideo[]

  @@index([orgId])
  @@index([archivedAt])
  @@index([deletedAt])
}

model GalleryVideo {
  galleryId String
  videoId   String

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  video   Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  stackKey String?
  version  Int?

  @@id([galleryId, videoId])
  @@index([galleryId])
  @@index([videoId])
  @@index([galleryId, stackKey, version])
}

model Org {
  id        String   @id
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installations Installation[]
  members       OrgMember[]

  videos    Video[]
  galleries Gallery[]

  storageUsedBytes  BigInt @default(0)

  // Which GHL Marketplace app this org installed through -- set once at
  // OAuth install (see lib/ghl/oauthCallback.ts) and never changed after,
  // since billing (lib/ghl/billing.ts) must never charge a PRIVATE org.
  appEdition AppEdition @default(PRIVATE)

  // Pricing plan -- see lib/storageLimit.ts for the per-plan default byte
  // limits. storageLimitBytes is the actual enforced value; it's seeded
  // from the plan's default at creation but independently overridable
  // (CUSTOM deals, promos, the OWNER plan's very large limit).
  plan              OrgPlan @default(STARTER)
  storageLimitBytes BigInt  @default(107374182400) // 100 GiB, matches PLAN_STORAGE_DEFAULTS.STARTER

  // The raw GHL Marketplace plan ID from the INSTALL/PLAN_CHANGE webhook
  // (see app/api/webhooks/ghl/route.ts) that `plan` above was last derived
  // from -- kept for audit/debugging, since GHL's ID is opaque on its own.
  ghlPlanId String?

  // GHL agency/company this location belongs to -- required by the Wallet
  // Charge API (companyId is a required field on every charge). Captured
  // at OAuth login going forward; nullable because it wasn't captured
  // historically and gets lazily backfilled via GET /locations/{id} the
  // first time a charge needs to go out for an org that's missing it.
  companyId String?

  // Storage-overage metered billing (see lib/ghl/billing.ts). Bytes of
  // overage already charged in the current monthly window, so the cron
  // only ever bills newly-crossed bytes, not the same overage repeatedly.
  overageBilledBytes        BigInt    @default(0)
  overageBillingPeriodStart DateTime?

  // Fair-use anti-cycling meter: cumulative bytes of videos that reached
  // Mux's "ready" state this calendar month, never decremented by delete
  // (unlike storageUsedBytes above). Mux bills storage per minute with a
  // one-month minimum per asset regardless of how quickly it's deleted, so
  // an org that fills-deletes-refills repeatedly costs real money without
  // ever tripping the live-storage overage check. The overage cron bills
  // whichever of the two meters shows more overage -- see
  // FAIR_USE_INGEST_MULTIPLIER in lib/storageLimit.ts. ingestPeriodStart is
  // updated by the webhook that increments this counter, not by the cron
  // (unlike overageBillingPeriodStart's lazy reset), since the webhook is
  // the only thing that needs to decide reset-vs-increment in real time.
  ingestedBytesThisPeriod BigInt    @default(0)
  ingestPeriodStart       DateTime?

  defaultSmsTemplateId   String?
  defaultEmailTemplateId String?
  defaultEmailTemplateSource String? // "classic" | "builder"
  defaultEmailTemplateName   String? // display name (mainly for builder templates, which aren't in a flat list)
  defaultEmailTemplatePreviewUrl String? // builder templates only -- lets us re-fetch content without re-browsing folders

  notificationWebhookUrl String? // POSTed to when a client comments or acts on approval
  notificationEmail      String? // emailed directly (via Resend) on the same events, independent of the webhook above
}

model Installation {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([orgId])
}

model AppUser {
  id        String   @id
  email     String?
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgs OrgMember[]
}

model OrgMember {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      OrgRole
  createdAt DateTime @default(now())

  org  Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

enum OrgRole {
  NONE
  VIEWER
  UPLOADER
  CONTRIBUTOR
  ADMIN
}

enum ShareView {
  VIEW_ONLY
  REVIEW_DOWNLOAD
}

enum CommentRole {
  OWNER
  CLIENT
}

enum OrgPlan {
  STARTER
  STUDIO
  PRO
  CUSTOM
  OWNER // the app developer's own account -- unlimited, never billed
}

enum AppEdition {
  PRIVATE
  PAID
}

enum CommentStatus {
  OPEN
  RESOLVED
}

enum VideoStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum ApprovalStatus {
  PENDING
  CHANGES_REQUESTED
  APPROVED
}
